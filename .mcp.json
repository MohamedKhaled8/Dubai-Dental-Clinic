{
  "mcpServers": {
    "21st-dev": {
      "command": "npx",
      "args": ["-y", "@21st-dev/mcp-server"],
      "env": {
        "API_KEY": "${TWENTY_FIRST_API_KEY}"
      }
    },
    "ui-ux-pro-max": {
      "command": "npx",
      "args": ["-y", "ui-ux-pro-mcp"]
    },
    "context-mode": {
      "command": "npx",
      "args": ["-y", "context-mode"]
    },
    "agent-skills": {
      "command": "npx",
      "args": ["-y", "@tech-leads-club/agent-skills-mcp"]
    }
  }
}